{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis - Tobias' personlige AI-operativsystem (fase 1: sikkerhets- og prosjektfundament)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "check:containment": "node ops/security/check-containment.mjs",
    "check:schema-classes": "node --experimental-transform-types modules/core/scripts/check-schema-classes.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.11",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
