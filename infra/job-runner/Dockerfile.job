# WP-C1 (D-32 / Q-45a): jobb-image for kodejobber som kjøres av den vertsside job-runneren (ops/job-runner).
#
# Bygg (på verten, som en bruker med docker-tilgang):   infra/job-runner/build-job-image.sh
#   = docker build -f infra/job-runner/Dockerfile.job infra/job-runner/claude-code      (build-konteksten er KUN mappen claude-code/)
#
# Prinsipper:
#  - Minimalt og reproduserbart: baseimaget er pinnet til digest (samme som voice-gateway.Dockerfile), Claude Code CLI installeres fra en
#    LOCKFIL med integritet for ALLE pakker (wrapper + plattformbinær) via `npm ci` - ingen flytende versjoner.
#  - Ikke-root: bruker `job` (uid/gid 10001). Runner-tjenesten starter containeren read-only med `--user`, cap-drop ALL,
#    no-new-privileges, minne/CPU/PID-grenser og kun /work montert - dette imaget antar ingenting annet (se job-container-spec.mjs).
#  - Ingen hemmeligheter i imaget: verken git-credential, Anthropic-nøkkel eller konfig bakes inn. ANTHROPIC_API_KEY kommer som env ved
#    opprettelse; git-credentialen finnes ikke i containeren i det hele tatt (klone/push skjer på verten).
#  - Telemetri/auto-oppdatering av: containeren når kun egress-proxyens allowlist (github.com, api.github.com, api.anthropic.com).
#
# Claude Code-versjon: 2.1.286 = npm-dist-tag `stable` per 2026-10-09 (publisert 2026-09-30); verifisert mot npm-metadata (integritet i
# claude-code/package-lock.json). KOMPATIBILITET med flaggene ClaudeCodeAgent bruker (-p, --bare, --output-format json, --permission-mode
# acceptEdits, --allowedTools) er bekreftet mot offisiell dokumentasjon (code.claude.com/docs/en/headless), men IKKE kjørt mot denne
# versjonen i dette miljøet - eieren verifiserer med ops/job-runner/acceptance.sh (steg «claude --version» og valgfri live-kjøring).
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

# git: lokale operasjoner (checkout -b, add, commit, bundle create). ca-certificates: TLS mot api.anthropic.com via proxyen.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Claude Code CLI fra lockfil. `postinstall` kopierer plattformbinæren (linux-x64/arm64, glibc) til bin/claude.exe - IKKE --ignore-scripts / --omit=optional.
WORKDIR /opt/claude-code
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
 && ln -s /opt/claude-code/node_modules/.bin/claude /usr/local/bin/claude \
 && npm cache clean --force \
 && claude --version \
 && git --version

# Ikke-root bruker + /work (bind-montert fra verten ved kjøring) + /home/job (tmpfs ved kjøring).
RUN groupadd --gid 10001 job \
 && useradd --uid 10001 --gid 10001 --home-dir /home/job --no-create-home --shell /usr/sbin/nologin job \
 && mkdir -p /work /home/job \
 && chown 10001:10001 /work /home/job

# Ingen setuid/setgid-filer i imaget (su, mount, passwd, newgrp ...). Containeren kjører allerede med no-new-privileges og cap-drop ALL, så de er virkningsløse; de trenger likevel
# ikke finnes (forsvar i dybden hvis et av de to flaggene en gang skulle falle bort). `find` gir exit 0 uten treff.
RUN find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} +

ENV HOME=/home/job \
    LANG=C.UTF-8 \
    GIT_TERMINAL_PROMPT=0 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
    CLAUDE_CODE_PROXY_RESOLVES_HOSTS=1

USER 10001:10001
WORKDIR /work
CMD ["sleep", "infinity"]
