# WP-C1 (D-32 / Q-45a): vertsside job-runner for kodejobber. Installeres til /etc/systemd/system/ av infra/job-runner/install-host.sh.
#
# VIKTIG - tillitsgrense: brukeren er i docker-gruppen (SupplementaryGroups=docker) og er dermed EFFEKTIVT ROOT på verten via docker-daemonen.
# systemd-herdingen under begrenser derfor kun hva SELVE Node-prosessen kan gjøre; sikkerheten hviler på at koden i ops/job-runner/ aldri
# tar imot flagg, mounts, image, nettverk eller stier fra API-et (se docs/runbooks/JOB_RUNNER.md, «Tillitsmodell»). Koden installeres
# root-eid og skrivebeskyttet for tjenestebrukeren, slik at en kompromittert prosess ikke kan endre sin egen kode eller policy.
[Unit]
Description=Jarvis job-runner (vertsside kodejobb-containere, WP-C1)
Documentation=https://github.com/tsworkflow/jarvisbuild/blob/main/docs/runbooks/JOB_RUNNER.md
After=network-online.target docker.service jarvis-egress-proxy.service
Wants=network-online.target jarvis-egress-proxy.service
Requires=docker.service
ConditionPathExists=/etc/jarvis/job-runner.json

[Service]
Type=simple
# Primærgruppen er socket-gruppen: medlemmer (worker-containeren via group_add) kan koble til socketen; ingen andre.
User=jarvis-runner
Group=jarvis-job-clients
SupplementaryGroups=docker
Environment=JARVIS_JOB_RUNNER_CONFIG=/etc/jarvis/job-runner.json
WorkingDirectory=/opt/jarvis-job-runner
ExecStart=/usr/bin/env node /opt/jarvis-job-runner/ops/job-runner/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
# /run/jarvis-job-runner (socket) og /var/lib/jarvis-job-runner (jobbkataloger) eies av tjenestebrukeren.
RuntimeDirectory=jarvis-job-runner
RuntimeDirectoryMode=0750
StateDirectory=jarvis-job-runner
StateDirectoryMode=0700
UMask=0077

# --- herding ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvis-job-runner /run/jarvis-job-runner
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Node/V8 trenger JIT (skrivbart+kjørbart minne): MemoryDenyWriteExecute kan derfor ikke slås på.
MemoryDenyWriteExecute=no
LimitNOFILE=4096
TasksMax=512

[Install]
WantedBy=multi-user.target
