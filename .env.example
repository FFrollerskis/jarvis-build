# Jarvis - eksempel på lokal miljøkonfigurasjon (fase 1).
# Kopier til .env (git-ignorert) og fyll inn lokalt. ALDRI commit ekte verdier.
# Secrets-strategi: docs/security/SECRETS_STRATEGY.md (D-16).

# apps/api
JARVIS_API_PORT=3010
JARVIS_ENV=dev

# Database (fase 2). Verdier settes lokalt i .env - aldri her.
#
# Q-21 (2026-08-15): JARVIS_DB_USER/PASSWORD er RUNTIME-credentials - de app/worker
# faktisk kobler til databasen med, LØPENDE. MÅ ALDRI være samme rolle som
# JARVIS_DB_ADMIN_USER/PASSWORD, og MÅ ALDRI være `jarvis_app` (den er en NOLOGIN
# gruppe-rolle, 005_rls.sql - kan ikke logges inn med direkte). `jarvis_runtime`
# bootstrappes automatisk (idempotent, NOSUPERUSER NOBYPASSRLS, medlem av jarvis_app)
# av migrate-tjenesten ved oppstart - sett bare et PASSORD her selv (eller kjør
# `node --experimental-transform-types modules/core/scripts/fix-q21-runtime-role.ts`
# som genererer et sikkert passord automatisk).
JARVIS_DB_HOST=127.0.0.1
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis
JARVIS_DB_USER=jarvis_runtime
JARVIS_DB_PASSWORD=
# KUN for migrasjoner/bootstrap (migrate-main.ts) og docker-compose sin Postgres-
# container selv - ALDRI for løpende api/worker-runtime:
JARVIS_DB_ADMIN_USER=postgres
JARVIS_DB_ADMIN_PASSWORD=

# Modell-leverandører (fase 3). Verdier settes lokalt i .env / SOPS - ALDRI her.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JARVIS_OLLAMA_URL=
# Budsjett: sett til true KUN etter aktiv godkjenning over 2000 kr/mnd (D-09)
JARVIS_BUDGET_APPROVED=false
# Kjør migrasjoner ved oppstart (krever adminrettigheter i databasen)
JARVIS_DB_RUN_MIGRATIONS=false
# Langfuse (aktiveres når selvhostet instans finnes - krever Docker/NAS)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
