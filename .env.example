# Jarvis - eksempel på lokal miljøkonfigurasjon (fase 1).
# Kopier til .env (git-ignorert) og fyll inn lokalt. ALDRI commit ekte verdier.
# Secrets-strategi: docs/security/SECRETS_STRATEGY.md (D-16).

# apps/api
JARVIS_API_PORT=3010
JARVIS_ENV=dev

# Database (fase 2). Verdier settes lokalt i .env - aldri her.
JARVIS_DB_HOST=127.0.0.1
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis
JARVIS_DB_USER=jarvis_app
JARVIS_DB_PASSWORD=
# Kun for docker-compose (admin/superuser):
JARVIS_DB_ADMIN_USER=postgres
JARVIS_DB_ADMIN_PASSWORD=

# Modell-leverandører (fase 3). Verdier settes lokalt i .env / SOPS - ALDRI her.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
JARVIS_OLLAMA_URL=
# Budsjett: sett til true KUN etter aktiv godkjenning over 2000 kr/mnd (D-09)
JARVIS_BUDGET_APPROVED=false
# Kjør migrasjoner ved oppstart (krever adminrettigheter i databasen)
JARVIS_DB_RUN_MIGRATIONS=false
# Langfuse (aktiveres når selvhostet instans finnes - krever Docker/NAS)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
