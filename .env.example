# §4.12 Kart
# D-298: Google Maps Platform API-nøkkel (Geocoding API aktivert). Brukes av
# `GoogleMapsTransport` (`google_maps.geocode`/`reverse_geocode`) - sendes
# som `key`-query-parameter, IKKE en header. BEVISST AVGRENSET til KUN
# Geocoding.
JARVIS_GOOGLE_MAPS_API_KEY=
# D-303: Google Places Platform API-nøkkel (det ELDRE, stabile Places-API-et
# aktivert - IKKE det nyere v1 Places-API-et). Brukes av
# `GooglePlacesTransport` (`google_places.search_places`/`get_place_details`)
# - sendes som `key`-query-parameter, samme mønster som Google Maps over.
JARVIS_GOOGLE_PLACES_API_KEY=
# D-304: Google Routes-nøkkel (det ELDRE, stabile Directions-/Distance
# Matrix-API-et aktivert - IKKE det nyere v2 Routes-API-et). Brukes av
# `GoogleRoutesTransport` (`google_routes.get_directions`/`get_distance_matrix`)
# - sendes som `key`-query-parameter, samme mønster som Google Maps/Places.
JARVIS_GOOGLE_ROUTES_API_KEY=

# §4.13 Observability
# D-297: Sentry auth-token (sentry.io/settings/account/api/auth-tokens/) +
# organisasjons-slug. Brukes av `SentryTransport` (`sentry.list_projects`/
# `list_issues`/`get_issue`/`update_issue`) - `Authorization: Bearer`-header.
# `update_issue` er ENESTE skrivehandling (klasse B, issue-status), reversibel
# OG idempotent - ULIK Slack/Discord/Twilio sin `notify`. IKKE denne-økten-
# verifisert mot live dokumentasjon (nettverksegress blokkert, se D-297 i
# DECISIONS_AND_ASSUMPTIONS.md) - `SENTRY_LIVE_GATE=PENDING_CREDENTIALS`
# krever en EKTE test med begge verdiene FØR `LIVE_VERIFIED`.
JARVIS_SENTRY_API_TOKEN=
JARVIS_SENTRY_ORG_SLUG=
# D-305: Grafana API-nøkkel (service account-token, Grafana >= 9) + base-URL.
# Brukes av `GrafanaTransport` (`grafana.search_dashboards`/`get_dashboard`)
# - `Authorization: Bearer`-header. Grafana er TYPISK selv-hostet (INGEN fast
# SaaS-domene som sentry.io) - base-URL-en MÅ konfigureres, samme resolver-
# mønster som Sentry sin org-slug over. IKKE denne-økten-verifisert mot live
# dokumentasjon (nettverksegress blokkert, se D-297 i
# DECISIONS_AND_ASSUMPTIONS.md) - `GRAFANA_LIVE_GATE=PENDING_CREDENTIALS`
# krever en EKTE test med begge verdiene FØR `LIVE_VERIFIED`.
JARVIS_GRAFANA_API_KEY=
JARVIS_GRAFANA_API_BASE_URL=
# D-306: Prometheus bearer-token + base-URL. Brukes av `PrometheusTransport`
# (`prometheus.query`/`query_range`) - `Authorization: Bearer`-header. SAMME
# "typisk selv-hostet"-struktur som Grafana over - base-URL-en MÅ
# konfigureres. IKKE denne-økten-verifisert mot live dokumentasjon
# (nettverksegress blokkert, se D-297 i DECISIONS_AND_ASSUMPTIONS.md) -
# `PROMETHEUS_LIVE_GATE=PENDING_CREDENTIALS` krever en EKTE test med begge
# verdiene FØR `LIVE_VERIFIED`.
JARVIS_PROMETHEUS_TOKEN=
JARVIS_PROMETHEUS_API_BASE_URL=

# §4.15 OS / enhet (Windows/macOS er BEVISST UTELATT - IKKE EN CONNECTOR, Q-39)
JARVIS_APNS_AUTH_KEY=
JARVIS_IOS_SHORTCUTS_TOKEN=
JARVIS_APPLE_WATCH_TOKEN=
