{
  "_comment_host": "Must equal this machine's ACTUAL hostname. The supervisor refuses to start if it does not - a control comment naming a host proves nothing on its own, so the binding is verified against os.hostname() at load time.",

  "repoOwner": "tsworkflow",
  "repoName": "jarvisbuild",
  "controlIssue": 68,
  "trustedAuthor": "tsworkflow",

  "workerTaskName": "JarvisClaudeWorker",
